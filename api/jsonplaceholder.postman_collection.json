{
  "info": {
    "name": "Afya QA Júnior - JSONPlaceholder",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" }
  ],
  "item": [
    {
      "name": "GET /posts/1 - sucesso",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/posts/1", "host": ["{{baseUrl}}"], "path": ["posts", "1"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status HTTP deve ser 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('id deve ser 1', function () { pm.expect(body.id).to.eql(1); });",
              "pm.test('userId deve ser 1', function () { pm.expect(body.userId).to.eql(1); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /posts/999999 - recurso inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/posts/999999", "host": ["{{baseUrl}}"], "path": ["posts", "999999"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registrar status do recurso inexistente', function () { pm.expect(pm.response.code).to.be.a('number'); });",
              "pm.test('Resposta deve conter corpo ou estar explicitamente vazia', function () { pm.expect(pm.response.text()).to.be.a('string'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
